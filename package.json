{
  "name": "synkd",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted PartyKit-compatible realtime rooms on Node and celld",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "synkd": "./packages/cli/dist/bin.js"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "up": "pnpm --filter @synkd/cli exec tsx src/bin.ts up --root ../../apps/parties",
    "down": "pnpm --filter @synkd/cli exec tsx src/bin.ts down",
    "dev": "pnpm run up",
    "dev:studio": "pnpm --filter @synkd/studio dev",
    "dev:console": "pnpm --filter @synkd/console dev",
    "dev:site": "pnpm --filter @synkd/site dev",
    "dev:all": "pnpm run build && concurrently -k -n runtime,studio,console,site -c cyan,magenta,yellow,green \"pnpm up\" \"pnpm dev:studio\" \"pnpm dev:console\" \"pnpm dev:site\"",
    "site:build": "pnpm --filter @synkd/site build",
    "doctor": "pnpm --filter @synkd/cli exec tsx src/bin.ts doctor --root ../../apps/parties",
    "deploy": "pnpm --filter @synkd/cli exec tsx src/bin.ts deploy --root ../../apps/parties",
    "test": "pnpm -r --filter=./packages/* run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run typecheck",
    "studio:build": "pnpm --filter @synkd/studio build",
    "console:build": "pnpm --filter @synkd/console build",
    "celld:smoke": "bash ./scripts/celld-smoke.sh",
    "ws:smoke": "pnpm --filter @synkd/runtime exec node ./scripts/ws-smoke.mjs",
    "fleet:minio": "SYNKD_MINIO=1 bash ./scripts/compose.sh up -d",
    "fleet:smoke": "bash ./scripts/fleet-smoke.sh",
    "fleet:up": "bash ./scripts/compose.sh up -d",
    "test:e2e": "pnpm --filter @synkd/studio run test:e2e",
    "test:e2e:console": "pnpm --filter @synkd/console run test:e2e"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
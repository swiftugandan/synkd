    "@sinkd/runtime": "workspace:*",
    "@sinkd/server": "workspace:*",
    "commander": "^14.0.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
